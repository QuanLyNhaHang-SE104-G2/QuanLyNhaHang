<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
                    xmlns:controls="clr-namespace:QuanLyNhaHang.Controls">

    <Style TargetType="controls:ControlTable">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:ControlTable">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Inner DataGrid (displays Content passed inside Content slot) -->
                            <RowDefinition Height="*"/>
                            <!-- Add Row Button (above pagination) -->
                            <RowDefinition Height="Auto"/>
                            <!-- Footer: Pagination (below Add Row Button) -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Content Area: The editable DataGrid -->
                        <ContentPresenter Grid.Row="0" Content="{TemplateBinding Content}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

                        <!-- Row 1: Add Row Button (Bottom-Right, above pagination) -->
                        <Button Grid.Row="1" Style="{StaticResource ButtonPrimary}"
                                Command="{TemplateBinding AddRowCommand}"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconBlock Icon="Plus" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Thêm món" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Row 2: Pagination Footer (below Add Row Button) -->
                        <Grid Grid.Row="2" Margin="0,15,0,0" VerticalAlignment="Bottom">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Pagination Controls (Left/Center) using General Styles -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock Text="Số dòng:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,5,0"/>
                                <ComboBox Width="80" Style="{StaticResource InputComboBox}"
                                          ItemsSource="{TemplateBinding PageSizes}"
                                          SelectedItem="{Binding PageSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding TotalInfoText}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="15,0,0,0"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ButtonSecondary}" Padding="12,6" Margin="0,0,5,0"
                                        Command="{TemplateBinding PrevPageCommand}">
                                    <fa:IconBlock Icon="ChevronLeft" FontSize="12"/>
                                </Button>

                                <ComboBox Width="70" Style="{StaticResource InputComboBox}" Margin="0,0,5,0"
                                          ItemsSource="{TemplateBinding PageNumbers}"
                                          SelectedItem="{Binding PageNumber, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                                <Button Style="{StaticResource ButtonSecondary}" Padding="12,6"
                                        Command="{TemplateBinding NextPageCommand}">
                                    <fa:IconBlock Icon="ChevronRight" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
