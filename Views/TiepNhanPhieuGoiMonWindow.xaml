<Window x:Class="QuanLyNhaHang.Views.TiepNhanPhieuGoiMonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Ticket Info Header Form -->
            <RowDefinition Height="Auto"/>
            <!-- Detail Grid Table (ControlTable) -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Phiếu gọi món" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Ticket Info Header Form -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Labels for MaPhieu, TenBan, ThoiGian -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Controls for MaPhieu, TenBan, ThoiGian -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Space / Margin -->
                    <RowDefinition Height="10"/>
                    <!-- Row 3: Labels for TrangThai, NhanVien, TongTien -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 4: Controls for TrangThai, NhanVien, TongTien -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Labels -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã phiếu gọi món" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Tên bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Thời gian gọi" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- Row 1: Controls -->
                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding MaPhieuGoiMon, Mode=OneWay}"/>
                <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource InputComboBox}" ItemsSource="{Binding Bans}" SelectedValue="{Binding SelectedMaBan}" DisplayMemberPath="TenBan" SelectedValuePath="MaBan"/>
                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding ThoiGianGoi, StringFormat={}{0:dd/MM/yyyy HH:mm}, Mode=OneWay}"/>

                <!-- Row 3: Labels -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Trạng thái phiếu" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Nhân viên phục vụ" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="4" Text="Tổng tiền tạm tính" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- Row 4: Controls -->
                <ComboBox Grid.Row="4" Grid.Column="0" Style="{StaticResource InputComboBox}" ItemsSource="{Binding TrangThais}" SelectedValue="{Binding SelectedMaTrangThai}" DisplayMemberPath="TenTrangThai" SelectedValuePath="MaTrangThai"/>
                <ComboBox Grid.Row="4" Grid.Column="2" Style="{StaticResource InputComboBox}" ItemsSource="{Binding NhanViens}" SelectedValue="{Binding SelectedMaNhanVien}" DisplayMemberPath="TenNhanVien" SelectedValuePath="MaNhanVien"/>
                <TextBox Grid.Row="4" Grid.Column="4" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding TongTienTamTinhText, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- Detail Grid Table (ControlTable) -->
        <controls:ControlTable Grid.Row="2" Margin="0,0,0,15"
                               VerticalAlignment="Stretch"
                               DishesSource="{Binding ActiveMonAns}"
                               ItemsSource="{Binding PagedItems}"
                               SelectedItem="{Binding SelectedOrderDetail}"
                               AddRowCommand="{Binding AddRowCommand}"
                               PageSize="{Binding PageSize, Mode=TwoWay}"
                               PageNumber="{Binding PageNumber, Mode=TwoWay}"
                               TotalInfoText="{Binding TotalInfoText}"
                               PrevPageCommand="{Binding PrevPageCommand}"
                               NextPageCommand="{Binding NextPageCommand}"
                               PageSizes="{Binding PageSizes}"
                               PageNumbers="{Binding PageNumbers}">
            <DataGrid ItemsSource="{Binding PagedItems}" SelectedItem="{Binding SelectedOrderDetail}"
                      Style="{StaticResource GeneralDataGrid}"
                      VerticalScrollBarVisibility="Visible"
                      Validation.ErrorTemplate="{x:Null}"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTemplateColumn Header="TÊN MÓN ĂN" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          VerticalAlignment="Center" Margin="2"
                                          ItemsSource="{Binding DishesSource, RelativeSource={RelativeSource AncestorType={x:Type controls:ControlTable}}}"
                                          SelectedValue="{Binding SelectedMaMonAn, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="TenMonAn"
                                          SelectedValuePath="MaMonAn"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SỐ LƯỢNG" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         VerticalAlignment="Center" Margin="2"
                                         Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ĐƠN VỊ TÍNH" Width="110" Binding="{Binding TenDonViTinh}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="10,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="ĐƠN GIÁ" Width="*" Binding="{Binding DonGiaText}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Margin" Value="10,0,0,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTemplateColumn Header="GHI CHÚ" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         VerticalAlignment="Center" Margin="2"
                                         Text="{Binding GhiChu, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="THAO TÁC" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ButtonDanger}" Padding="6,4" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:ControlTable}}}"
                                        CommandParameter="{Binding}">
                                    <fa:IconBlock Icon="Trash" FontSize="12"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </controls:ControlTable>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3">
            <Button x:Name="BtnAccept" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" Command="{Binding AcceptCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Plus" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Lập phiếu gọi món" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Style="{StaticResource ButtonSecondary}" Command="{Binding ResetCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Undo" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đặt lại" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCancel" Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Times" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
