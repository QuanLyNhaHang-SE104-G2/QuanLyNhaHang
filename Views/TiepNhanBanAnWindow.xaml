<Window x:Class="QuanLyNhaHang.Views.TiepNhanBanAnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:ext="clr-namespace:QuanLyNhaHang.Extensions"
        xmlns:vm="clr-namespace:QuanLyNhaHang.ViewModels"
        mc:Ignorable="d"
        Title="" Height="480" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Form Body -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Tiếp nhận bàn ăn" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Form Body -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Mã bàn ăn & Tên bàn ăn -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Mã bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding MaBan, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Tên bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtTenBan" Style="{StaticResource InputTextBox}" Text="{Binding TenBan, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Row 1: Khu vực & Số chỗ ngồi -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Khu vực" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtKhuVuc" Style="{StaticResource InputTextBox}" Text="{Binding KhuVuc, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Số chỗ ngồi" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtSoChoNgoi" Style="{StaticResource InputTextBox}" Text="{Binding SoChoNgoi, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Row 2: Tên loại bàn & Phụ thu -->
                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Tên loại bàn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbLoaiBan" Style="{StaticResource InputComboBox}" ItemsSource="{Binding LoaiBans}" SelectedValue="{Binding SelectedMaLoaiBan}" DisplayMemberPath="TenLoaiBan" SelectedValuePath="MaLoaiBan"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Phụ thu" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="TxtPhuThu" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding PhuThuText, Mode=OneWay}"/>
                </StackPanel>

                <!-- Row 3: Số chỗ ngồi tối thiểu -->
                <StackPanel Grid.Row="3" Grid.Column="0">
                    <TextBlock Text="Số chỗ ngồi tối thiểu" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="TxtSoChoNgoiToiThieu" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding SoChoNgoiToiThieu, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Button x:Name="BtnAccept" Content="+ Tiếp nhận bàn ăn" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" Command="{Binding AcceptCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Content="Đặt lại" Style="{StaticResource ButtonSecondary}" Command="{Binding ResetCommand}" Margin="0,0,10,0"/>
                <Button x:Name="BtnCancel" Content="Thoát" Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
