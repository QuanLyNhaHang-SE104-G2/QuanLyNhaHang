<Window x:Class="QuanLyNhaHang.Views.CapNhatNhanVienWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="Cập nhật nhân viên" Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Form Body -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Cập nhật nhân viên" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Form Body -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <!-- Mã nhân viên -->
                <TextBlock Text="Mã nhân viên" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding MaNhanVien, Mode=OneWay}" Margin="0,0,0,12"/>

                <!-- Tên nhân viên -->
                <TextBlock Text="Tên nhân viên" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtTenNhanVien" Style="{StaticResource InputTextBox}" Text="{Binding TenNhanVien, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Button x:Name="BtnAccept" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" Command="{Binding AcceptCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Save" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cập nhật" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Style="{StaticResource ButtonSecondary}" Command="{Binding ResetCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Undo" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đặt lại" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="BtnCancel" Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Times" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
