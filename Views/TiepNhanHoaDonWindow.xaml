<Window x:Class="QuanLyNhaHang.Views.TiepNhanHoaDonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="Thanh toán" Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Invoice Info Form -->
            <RowDefinition Height="Auto"/>
            <!-- Details Grid (Paginated) -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Thanh toán" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Invoice Info Form -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Labels -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Controls -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/> <!-- Mã thanh toán -->
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/> <!-- Tên bàn -->
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/> <!-- Thời gian thanh toán -->
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/> <!-- Phụ thu -->
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/> <!-- Tổng tiền -->
                </Grid.ColumnDefinitions>

                <!-- Row 0: Labels -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã thanh toán" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Tên bàn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Thời gian thanh toán" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Phụ thu" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="8" Text="Tổng tiền" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- Row 1: Controls -->
                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding MaHoaDon, Mode=OneWay}"/>
                <ComboBox Grid.Row="1" Grid.Column="2" Style="{StaticResource InputComboBox}" ItemsSource="{Binding Bans}" SelectedValue="{Binding SelectedMaBan}" DisplayMemberPath="TenBan" SelectedValuePath="MaBan"/>
                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding ThoiGianThanhToan, StringFormat={}{0:dd/MM/yyyy HH:mm}, Mode=OneWay}"/>
                <TextBox Grid.Row="1" Grid.Column="6" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding PhuThuText, Mode=OneWay}"/>
                <TextBox Grid.Row="1" Grid.Column="8" Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding TongTienText, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- Details Grid (Paginated) -->
        <controls:PaginatedView Grid.Row="2" Style="{StaticResource PopupPaginatedViewStyle}" Margin="0,0,0,15"
            PageSize="{Binding PageSize, Mode=TwoWay}"
            PageNumber="{Binding PageNumber, Mode=TwoWay}"
            TotalInfoText="{Binding TotalInfoText}"
            PrevPageCommand="{Binding PrevPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            PageSizes="{Binding PageSizes}"
            PageNumbers="{Binding PageNumbers}">

            <controls:PaginatedView.MainContent>
                <DataGrid ItemsSource="{Binding PagedItems}" IsReadOnly="True" Style="{StaticResource GeneralDataGrid}"
                          Validation.ErrorTemplate="{x:Null}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="TÊN MÓN ĂN" Width="2*" Binding="{Binding TenMonAn}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SỐ LƯỢNG" Width="100" Binding="{Binding SoLuong}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ĐƠN VỊ TÍNH" Width="110" Binding="{Binding TenDonViTinh}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="ĐƠN GIÁ" Width="1.5*" Binding="{Binding DonGiaText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="THỜI GIAN" Width="1.8*" Binding="{Binding ThoiGianGoiText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="THÀNH TIỀN" Width="1.5*" Binding="{Binding ThanhTienText}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Margin" Value="10,0,0,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </controls:PaginatedView.MainContent>
        </controls:PaginatedView>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3">
            <Button x:Name="BtnAccept" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" Command="{Binding AcceptCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Plus" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Lập phiếu thanh toán" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Style="{StaticResource ButtonSecondary}" Command="{Binding ResetCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Undo" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đặt lại" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCancel" Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Times" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
