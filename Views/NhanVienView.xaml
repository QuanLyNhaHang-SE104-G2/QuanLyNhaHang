<UserControl x:Class="QuanLyNhaHang.Views.NhanVienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
             Background="{StaticResource BackgroundBrush}">
    <controls:PaginatedView Title="Quản lý Nhân viên"
        PageSize="{Binding PageSize, Mode=TwoWay}"
        PageNumber="{Binding PageNumber, Mode=TwoWay}"
        TotalInfoText="{Binding TotalInfoText}"
        PrevPageCommand="{Binding PrevPageCommand}"
        NextPageCommand="{Binding NextPageCommand}"
        PageSizes="{Binding PageSizes}"
        PageNumbers="{Binding PageNumbers}">

        <controls:PaginatedView.ButtonContent>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ButtonPrimary}" Command="{Binding AddNhanVienCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Plus" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thêm nhân viên" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ButtonDanger}" Command="{Binding DeleteNhanVienCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Trash" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding EditNhanVienCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Edit" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sửa" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PaginatedView.ButtonContent>

        <controls:PaginatedView.MainContent>
            <DataGrid ItemsSource="{Binding NhanViens}" IsReadOnly="True" Style="{StaticResource GeneralDataGrid}"
                      SelectedItem="{Binding SelectedNhanVien}"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}"/>
                    <DataGridTextColumn Header="MÃ NHÂN VIÊN" Width="150" Binding="{Binding MaNhanVien}"/>
                    <DataGridTextColumn Header="TÊN NHÂN VIÊN" Width="*" Binding="{Binding TenNhanVien}"/>
                </DataGrid.Columns>
            </DataGrid>
        </controls:PaginatedView.MainContent>
    </controls:PaginatedView>
</UserControl>
