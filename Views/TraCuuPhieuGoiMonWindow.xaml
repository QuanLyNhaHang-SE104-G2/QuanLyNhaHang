<Window x:Class="QuanLyNhaHang.Views.TraCuuPhieuGoiMonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="Tra cứu" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search Form -->
            <RowDefinition Height="Auto"/>
            <!-- Data Grid / Results -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Tra cứu Phiếu gọi món" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Row 1: Search Form -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Labels for MaPhieu, TenBan, NhanVien, TrangThai -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Controls for MaPhieu, TenBan, NhanVien, TrangThai -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Space / Margin -->
                    <RowDefinition Height="10"/>
                    <!-- Row 3: Label for TongTien -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 4: Range Input Control for TongTien -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 5: Space / Margin -->
                    <RowDefinition Height="15"/>
                    <!-- Row 6: Buttons -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Row 0: Labels -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã phiếu gọi món" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Nhân viên" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="Trạng thái" FontWeight="SemiBold" Margin="0,0,0,5"/>
                
                <!-- Row 1: Controls -->
                <TextBox Grid.Row="1" Grid.Column="0" Style="{StaticResource InputTextBox}" Text="{Binding MaPhieuGoiMon, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="1" Grid.Column="2" Style="{StaticResource InputTextBox}" Text="{Binding TenBan, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource InputTextBox}" Text="{Binding TenNhanVien, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Grid.Row="1" Grid.Column="6" Style="{StaticResource InputComboBox}" ItemsSource="{Binding TrangThais}" SelectedValue="{Binding SelectedMaTrangThai}" DisplayMemberPath="TenTrangThai" SelectedValuePath="MaTrangThai"/>

                <!-- Row 3: Label -->
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" Text="Tổng tiền tạm tính" FontWeight="SemiBold" Margin="0,0,0,5"/>

                <!-- Row 4: Control -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="từ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding TongTienTu, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding TongTienDen, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Row 6: Buttons -->
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SearchCommand}" Margin="0,0,15,0" Width="120">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Search" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tra cứu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="120">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Times" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Paginated View DataGrid -->
        <controls:PaginatedView Grid.Row="2" Style="{StaticResource PopupPaginatedViewStyle}"
            PageSize="{Binding PageSize, Mode=TwoWay}"
            PageNumber="{Binding PageNumber, Mode=TwoWay}"
            TotalInfoText="{Binding TotalInfoText}"
            PrevPageCommand="{Binding PrevPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            PageSizes="{Binding PageSizes}"
            PageNumbers="{Binding PageNumbers}">
            
            <controls:PaginatedView.MainContent>
                <DataGrid ItemsSource="{Binding Orders}" IsReadOnly="True" Style="{StaticResource GeneralDataGrid}"
                          Validation.ErrorTemplate="{x:Null}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Width="0.6*" Binding="{Binding STT}"/>
                        <DataGridTextColumn Header="MÃ ĐƠN" Width="1.2*" Binding="{Binding MaPhieuGoiMon}"/>
                        <DataGridTextColumn Header="BÀN" Width="1.8*" Binding="{Binding TenBan}"/>
                        <DataGridTextColumn Header="THỜI GIAN" Width="1.8*" Binding="{Binding ThoiGianGoiText}"/>
                        <DataGridTextColumn Header="NHÂN VIÊN" Width="1.5*" Binding="{Binding TenNhanVien}"/>
                        <DataGridTextColumn Header="TRẠNG THÁI" Width="1.5*" Binding="{Binding TenTrangThai}"/>
                        <DataGridTextColumn Header="TỔNG TIỀN" Width="1.5*" Binding="{Binding TongTienText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </controls:PaginatedView.MainContent>
        </controls:PaginatedView>
    </Grid>
</Window>
