<Window x:Class="QuanLyNhaHang.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        mc:Ignorable="d"
        Title="Quản Lý Nhà Hàng" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="250"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Panel -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Brand / Logo Area -->
                <StackPanel Grid.Row="0" Margin="20,25,20,25">
                    <TextBlock Text="Hệ thống Quản lý" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Nhà hàng" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="10,0,10,0">
                    <!-- Danh sach ban navigation button -->
                    <Button Command="{Binding NavigateToSoDoBanCommand}" HorizontalContentAlignment="Left" Padding="15,10" Cursor="Hand" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBaseStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSoDoBanActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ActiveMenuBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Table" FontSize="16" Width="20"/>
                            <TextBlock Text="Danh sách bàn" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Thuc don navigation button -->
                    <Button Command="{Binding NavigateToThucDonCommand}" Margin="0,5,0,0" HorizontalContentAlignment="Left" Padding="15,10" Cursor="Hand" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBaseStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThucDonActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ActiveMenuBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Utensils" FontSize="16" Width="20"/>
                            <TextBlock Text="Thực đơn" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Danh sach goi mon navigation button -->
                    <Button Command="{Binding NavigateToPosCommand}" Margin="0,5,0,0" HorizontalContentAlignment="Left" Padding="15,10" Cursor="Hand" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBaseStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPosActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ActiveMenuBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Edit" FontSize="16" Width="20"/>
                            <TextBlock Text="Danh sách gọi món" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Bao cao navigation button -->
                    <Button Command="{Binding NavigateToBaoCaoCommand}" Margin="0,5,0,0" HorizontalContentAlignment="Left" Padding="15,10" Cursor="Hand" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBaseStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBaoCaoActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ActiveMenuBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="ChartBar" FontSize="16" Width="20"/>
                            <TextBlock Text="Báo cáo" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Hoa don thanh toan navigation button -->
                    <Button Command="{Binding NavigateToHoaDonCommand}" Margin="0,5,0,0" HorizontalContentAlignment="Left" Padding="15,10" Cursor="Hand" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBaseStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHoaDonActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ActiveMenuBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="CreditCard" FontSize="16" Width="20"/>
                            <TextBlock Text="Hóa đơn thanh toán" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- Quy dinh navigation button -->
                    <Button Command="{Binding NavigateToQuyDinhCommand}" Margin="0,5,0,0" HorizontalContentAlignment="Left" Padding="15,10" Cursor="Hand" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ControlBaseStyle}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Style.Resources>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuyDinhActive}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ActiveMenuBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="ClipboardList" FontSize="16" Width="20"/>
                            <TextBlock Text="Quy định" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dynamic Content Control Panel -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
