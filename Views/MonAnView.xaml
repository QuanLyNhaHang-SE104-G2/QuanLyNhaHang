<UserControl x:Class="QuanLyNhaHang.Views.MonAnView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
             Background="{StaticResource BackgroundBrush}">
    <controls:PaginatedView Title="Quản lý Thực đơn"
        PageSize="{Binding PageSize, Mode=TwoWay}"
        PageNumber="{Binding PageNumber, Mode=TwoWay}"
        TotalInfoText="{Binding TotalInfoText}"
        PrevPageCommand="{Binding PrevPageCommand}"
        NextPageCommand="{Binding NextPageCommand}"
        PageSizes="{Binding PageSizes}"
        PageNumbers="{Binding PageNumbers}">

        <controls:PaginatedView.ButtonContent>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ButtonPrimary}" Command="{Binding AddMonAnCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Plus" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Thêm món ăn" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
                <Button Style="{StaticResource ButtonDanger}" Command="{Binding DeleteMonAnCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Trash" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ButtonSecondary}" Command="{Binding EditMonAnCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Edit" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Sửa" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Tra cứu" Style="{StaticResource ButtonSecondary}" Margin="0,0,10,0"/>
            </StackPanel>
        </controls:PaginatedView.ButtonContent>

        <controls:PaginatedView.MainContent>
            <DataGrid ItemsSource="{Binding MonAns}" IsReadOnly="True" Style="{StaticResource GeneralDataGrid}"
                      SelectedItem="{Binding SelectedMonAn}"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}"/>
                    <DataGridTextColumn Header="TÊN MÓN ĂN" Width="*" Binding="{Binding TenMonAn}"/>
                    <DataGridTextColumn Header="LOẠI MÓN ĂN" Width="120" Binding="{Binding TenLoaiMonAn}"/>
                    <DataGridTextColumn Header="ĐƠN VỊ TÍNH" Width="110" Binding="{Binding TenDonViTinh}"/>
                    <DataGridTextColumn Header="ĐƠN GIÁ" Width="120" Binding="{Binding DonGiaText}"/>
                    <DataGridTextColumn Header="TÌNH TRẠNG" Width="120" Binding="{Binding TenTinhTrang}"/>
                </DataGrid.Columns>
            </DataGrid>
        </controls:PaginatedView.MainContent>
    </controls:PaginatedView>
</UserControl>
