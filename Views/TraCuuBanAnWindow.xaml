<Window x:Class="QuanLyNhaHang.Views.TraCuuBanAnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="Tra cứu" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search Form -->
            <RowDefinition Height="Auto"/>
            <!-- Data Grid / Results -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Tra cứu Bàn ăn" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Row 1: Search Form -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Row 0 of inputs: Mã bàn ăn, Tên bàn ăn, Khu vực, Tên loại bàn ăn -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding MaBan, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tên bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding TenBan, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Khu vực" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding KhuVuc, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Tên loại bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding LoaiBans}" SelectedValue="{Binding SelectedMaLoaiBan}" DisplayMemberPath="TenLoaiBan" SelectedValuePath="MaLoaiBan"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1 of inputs: Số chỗ ngồi và Phụ thu (ranges) -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Số chỗ ngồi" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="từ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding SoChoNgoiTu, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding SoChoNgoiDen, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Phụ thu" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="từ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding PhuThuTu, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding PhuThuDen, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Row 2 of inputs: Search and Exit buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SearchCommand}" Margin="0,0,15,0" Width="120">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Search" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tra cứu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="120">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Times" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Paginated View DataGrid -->
        <controls:PaginatedView Grid.Row="2" Style="{StaticResource PopupPaginatedViewStyle}"
            PageSize="{Binding PageSize, Mode=TwoWay}"
            PageNumber="{Binding PageNumber, Mode=TwoWay}"
            TotalInfoText="{Binding TotalInfoText}"
            PrevPageCommand="{Binding PrevPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            PageSizes="{Binding PageSizes}"
            PageNumbers="{Binding PageNumbers}">
            
            <controls:PaginatedView.MainContent>
                <DataGrid ItemsSource="{Binding Bans}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Style="{StaticResource GeneralDataGrid}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                            <Style.Triggers>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="TÊN BÀN" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding TenBan, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="LOẠI BÀN" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding TenLoaiBan}" VerticalAlignment="Center" Margin="5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <ComboBox VerticalAlignment="Center" Margin="2"
                                                  ItemsSource="{Binding DataContext.ActiveLoaiBans, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                  SelectedValue="{Binding SelectedMaLoaiBan, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="TenLoaiBan"
                                                  SelectedValuePath="MaLoaiBan">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource InputComboBox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="KHU VỰC" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding KhuVuc, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="SỐ CHỖ NGỒI" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding SoChoNgoiText}" VerticalAlignment="Center" Margin="5,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding SoChoNgoi, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PHỤ THU" Width="120" Binding="{Binding PhuThuText}" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="THAO TÁC" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ButtonSecondary}" Margin="0,0,5,0" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                                Command="{Binding DataContext.EditBanCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}">
                                            <fa:IconBlock FontSize="14">
                                                <fa:IconBlock.Style>
                                                    <Style TargetType="fa:IconBlock">
                                                        <Setter Property="Icon" Value="Edit"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                                                <Setter Property="Icon" Value="Check"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </fa:IconBlock.Style>
                                            </fa:IconBlock>
                                        </Button>
                                        <Button Style="{StaticResource ButtonDanger}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                                Command="{Binding DataContext.DeleteBanCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}">
                                            <fa:IconBlock Icon="Trash" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </controls:PaginatedView.MainContent>
        </controls:PaginatedView>
    </Grid>
</Window>
