<Window x:Class="QuanLyNhaHang.Views.TraCuuBanAnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="Tra cứu" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    
    <Window.Resources>
        <Style x:Key="PopupPaginatedViewStyle" TargetType="controls:PaginatedView">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="controls:PaginatedView">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Content Area -->
                            <ContentPresenter Grid.Row="0" Content="{TemplateBinding MainContent}"/>

                            <!-- Pagination Footer -->
                            <Grid Grid.Row="1" Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Số dòng:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,5,0"/>
                                    <ComboBox Width="80" Style="{StaticResource InputComboBox}"
                                              ItemsSource="{TemplateBinding PageSizes}"
                                              SelectedItem="{Binding PageSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding TotalInfoText}"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="15,0,0,0"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ButtonSecondary}" Padding="12,6" Margin="0,0,5,0"
                                            Command="{TemplateBinding PrevPageCommand}">
                                        <fa:IconBlock Icon="ChevronLeft" FontSize="12"/>
                                    </Button>

                                    <ComboBox Width="70" Style="{StaticResource InputComboBox}" Margin="0,0,5,0"
                                              ItemsSource="{TemplateBinding PageNumbers}"
                                              SelectedItem="{Binding PageNumber, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>

                                    <Button Style="{StaticResource ButtonSecondary}" Padding="12,6"
                                            Command="{TemplateBinding NextPageCommand}">
                                        <fa:IconBlock Icon="ChevronRight" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Search Form -->
            <RowDefinition Height="Auto"/>
            <!-- Data Grid / Results -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Tra cứu Bàn ăn" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Row 1: Search Form -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Row 0 of inputs: Mã bàn ăn, Tên bàn ăn, Khu vực, Tên loại bàn ăn -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding MaBan, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Tên bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding TenBan, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Khu vực" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Style="{StaticResource InputTextBox}" Text="{Binding KhuVuc, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Tên loại bàn ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox Style="{StaticResource InputComboBox}" ItemsSource="{Binding LoaiBans}" SelectedValue="{Binding SelectedMaLoaiBan}" DisplayMemberPath="TenLoaiBan" SelectedValuePath="MaLoaiBan"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1 of inputs: Số chỗ ngồi và Phụ thu (ranges) -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Số chỗ ngồi" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="từ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding SoChoNgoiTu, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding SoChoNgoiDen, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Phụ thu" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="từ" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding PhuThuTu, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="đến" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Style="{StaticResource InputTextBox}" Width="140" Text="{Binding PhuThuDen, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Row 2 of inputs: Search and Exit buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource ButtonPrimary}" Command="{Binding SearchCommand}" Margin="0,0,15,0" Width="120">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Search" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tra cứu" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Width="120">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Times" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: Paginated View DataGrid -->
        <controls:PaginatedView Grid.Row="2" Style="{StaticResource PopupPaginatedViewStyle}"
            PageSize="{Binding PageSize, Mode=TwoWay}"
            PageNumber="{Binding PageNumber, Mode=TwoWay}"
            TotalInfoText="{Binding TotalInfoText}"
            PrevPageCommand="{Binding PrevPageCommand}"
            NextPageCommand="{Binding NextPageCommand}"
            PageSizes="{Binding PageSizes}"
            PageNumbers="{Binding PageNumbers}">
            
            <controls:PaginatedView.MainContent>
                <DataGrid ItemsSource="{Binding Bans}" IsReadOnly="True" Style="{StaticResource GeneralDataGrid}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}"/>
                        <DataGridTextColumn Header="TÊN BÀN" Width="*" Binding="{Binding TenBan}"/>
                        <DataGridTextColumn Header="LOẠI BÀN" Width="120" Binding="{Binding TenLoaiBan}"/>
                        <DataGridTextColumn Header="KHU VỰC" Width="150" Binding="{Binding KhuVuc}"/>
                        <DataGridTextColumn Header="SỐ CHỖ NGỒI" Width="120" Binding="{Binding SoChoNgoiText}"/>
                        <DataGridTextColumn Header="PHỤ THU" Width="120" Binding="{Binding PhuThuText}"/>
                        <DataGridTemplateColumn Header="THAO TÁC" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ButtonSecondary}" Margin="0,0,5,0" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}">
                                            <fa:IconBlock Icon="Edit" FontSize="14"/>
                                        </Button>
                                        <Button Style="{StaticResource ButtonDanger}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}">
                                            <fa:IconBlock Icon="Trash" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </controls:PaginatedView.MainContent>
        </controls:PaginatedView>
    </Grid>
</Window>
