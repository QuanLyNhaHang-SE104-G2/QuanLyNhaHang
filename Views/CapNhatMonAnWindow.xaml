<Window x:Class="QuanLyNhaHang.Views.CapNhatMonAnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:vm="clr-namespace:QuanLyNhaHang.ViewModels"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="Cập nhật món ăn" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Form Body -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Cập nhật món ăn" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Form Body -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Row 0: Mã món ăn & Tên món ăn -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Mã món ăn" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource InputTextBoxReadOnly}" Text="{Binding MaMonAn, Mode=OneWay}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
                    <TextBlock Text="Tên món ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtTenMonAn" Style="{StaticResource InputTextBox}" Text="{Binding TenMonAn, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Row 1: Loại món ăn & Đơn vị tính & Đơn giá -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                    <TextBlock Text="Loại món ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbLoaiMonAn" Style="{StaticResource InputComboBox}" ItemsSource="{Binding LoaiMonAns}" SelectedValue="{Binding SelectedMaLoaiMonAn}" DisplayMemberPath="TenLoaiMonAn" SelectedValuePath="MaLoaiMonAn"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Đơn vị tính" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbDonViTinh" Style="{StaticResource InputComboBox}" ItemsSource="{Binding AllowedDonViTinhs}" SelectedValue="{Binding SelectedMaDonViTinh}" DisplayMemberPath="TenDonViTinh" SelectedValuePath="MaDonViTinh"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,12">
                    <TextBlock Text="Đơn giá" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDonGia" Style="{StaticResource InputTextBox}" Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Row 2: Tình trạng -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                    <TextBlock Text="Tình trạng" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbTinhTrang" Style="{StaticResource InputComboBox}" ItemsSource="{Binding TinhTrangs}" SelectedValue="{Binding SelectedMaTinhTrang}" DisplayMemberPath="TenTinhTrang" SelectedValuePath="MaTinhTrang"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Buttons -->
        <Grid Grid.Row="2">
            <Button x:Name="BtnAccept" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" Command="{Binding AcceptCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Save" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Cập nhật" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Style="{StaticResource ButtonSecondary}" Command="{Binding ResetCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Undo" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đặt lại" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                
                <Button x:Name="BtnCancel" Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Times" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
