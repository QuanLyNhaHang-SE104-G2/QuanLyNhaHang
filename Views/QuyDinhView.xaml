<UserControl x:Class="QuanLyNhaHang.Views.QuyDinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <!-- Header -->
                <TextBlock Text="Quy định" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Thay đổi các quy định phù hợp với nhà hàng" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,20"/>

                <!-- Card 1: Quy định 1 -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Quy định 1" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                        <!-- Controls Row -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Số chỗ ngồi tối thiểu" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                <TextBox Width="100" Style="{StaticResource InputTextBox}" Text="{Binding QuyDinh1.SoChoNgoiToiThieu, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Button Grid.Column="3" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinh1.ThemLoaiBanCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconBlock Icon="Plus" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thêm loại bàn mới" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Grid of LoaiBan -->
                        <DataGrid ItemsSource="{Binding QuyDinh1.LoaiBans}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Style="{StaticResource GeneralDataGrid}" Height="200" Margin="0,0,0,15" SelectionMode="Single">
                            <DataGrid.Resources>
                                <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="IsReadOnly" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="MÃ LOẠI BÀN" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding MaLoaiBan, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="TÊN LOẠI BÀN" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding TenLoaiBan, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="MỨC PHỤ THU" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding PhuThu, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="THAO TÁC" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Style="{StaticResource ButtonSecondary}" Margin="0,0,5,0" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                                        Command="{Binding DataContext.QuyDinh1.EditLoaiBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <fa:IconBlock Icon="Edit" FontSize="14"/>
                                                </Button>
                                                <Button Style="{StaticResource ButtonDanger}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding DataContext.QuyDinh1.DeleteLoaiBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <fa:IconBlock Icon="Trash" FontSize="14"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Save Button -->
                        <Button Content="Lưu thay đổi" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinh1.LuuThayDoiCommand}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Quy định 3 -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Quy định 3" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: Danh sách Loại món ăn -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Danh sách Loại món ăn" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinh3.ThemLoaiMonAnCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="Plus" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thêm loại món ăn" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <DataGrid ItemsSource="{Binding QuyDinh3.LoaiMonAns}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Style="{StaticResource GeneralDataGrid}" Height="180" Margin="0,0,0,10" SelectionMode="Single">
                                    <DataGrid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                            <Style.Triggers>
                                                <Trigger Property="IsReadOnly" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="MÃ LOẠI MÓN ĂN" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding MaLoaiMonAn, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="TÊN LOẠI MÓN ĂN" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding TenLoaiMonAn, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="THAO TÁC" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Style="{StaticResource ButtonSecondary}" Margin="0,0,5,0" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <fa:IconBlock Icon="Edit" FontSize="14"/>
                                                        </Button>
                                                        <Button Style="{StaticResource ButtonDanger}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                                                Command="{Binding DataContext.QuyDinh3.DeleteLoaiMonAnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <fa:IconBlock Icon="Trash" FontSize="14"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <!-- Column 2: Danh sách Đơn vị tính -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Danh sách Đơn vị tính" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinh3.ThemDonViTinhCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <fa:IconBlock Icon="Plus" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thêm đơn vị tính" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <DataGrid ItemsSource="{Binding QuyDinh3.DonViTinhs}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Style="{StaticResource GeneralDataGrid}" Height="180" Margin="0,0,0,10" SelectionMode="Single">
                                    <DataGrid.Resources>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                            <Style.Triggers>
                                                <Trigger Property="IsReadOnly" Value="True">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="MÃ ĐƠN VỊ TÍNH" Width="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding MaDonViTinh, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="TÊN ĐƠN VỊ TÍNH" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding TenDonViTinh, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="THAO TÁC" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Button Style="{StaticResource ButtonSecondary}" Margin="0,0,5,0" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}">
                                                            <fa:IconBlock Icon="Edit" FontSize="14"/>
                                                        </Button>
                                                        <Button Style="{StaticResource ButtonDanger}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                                                Command="{Binding DataContext.QuyDinh3.DeleteDonViTinhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                            <fa:IconBlock Icon="Trash" FontSize="14"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>

                        <!-- Save Button -->
                        <Button Content="Lưu thay đổi" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinh3.LuuThayDoiCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Quy định 5 -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Quy định 5" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Chỉ được thanh toán đối với bàn khi có ít nhất 1 phiếu gọi món có trạng thái:" FontSize="13" Margin="0,0,0,15"/>

                        <!-- List of checkboxes -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15" Background="#FAFAFA" HorizontalAlignment="Left" Width="300">
                            <ItemsControl ItemsSource="{Binding QuyDinh5.Statuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding TenTrangThai}" IsChecked="{Binding DuocThanhToan}" Margin="0,5,0,5" FontSize="13"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Save Button -->
                        <Button Content="Lưu thay đổi" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinh5.LuuThayDoiCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
