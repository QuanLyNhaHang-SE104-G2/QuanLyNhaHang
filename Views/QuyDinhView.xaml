<UserControl x:Class="QuanLyNhaHang.Views.QuyDinhView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
             xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20">
                <TextBlock Text="Quy định" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Thay đổi các quy định phù hợp với nhà hàng" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,20"/>

                <!-- Card 1: Quy định bàn ăn -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Quy định bàn ăn" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Số chỗ ngồi tối thiểu" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                                <TextBox Width="100" Style="{StaticResource InputTextBox}" Text="{Binding QuyDinhBanAn.SoChoNgoiToiThieu, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <controls:EditablePaginatedView HorizontalAlignment="Stretch"
                            AddRowButtonText="Thêm loại bàn mới"
                            AddRowCommand="{Binding QuyDinhBanAn.AddLoaiBanCommand}"
                            PageSize="{Binding QuyDinhBanAn.PageSize, Mode=TwoWay}"
                            PageNumber="{Binding QuyDinhBanAn.PageNumber, Mode=TwoWay}"
                            TotalInfoText="{Binding QuyDinhBanAn.TotalInfoText}"
                            PrevPageCommand="{Binding QuyDinhBanAn.PrevPageCommand}"
                            NextPageCommand="{Binding QuyDinhBanAn.NextPageCommand}"
                            PageSizes="{Binding QuyDinhBanAn.PageSizes}"
                            PageNumbers="{Binding QuyDinhBanAn.PageNumbers}">
                            <DataGrid ItemsSource="{Binding QuyDinhBanAn.PagedItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Style="{StaticResource GeneralDataGrid}" Height="200" Margin="0,0,0,5" SelectionMode="Single">
                                <DataGrid.Resources>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                        <Style.Triggers>
                                            <Trigger Property="IsReadOnly" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Mã loại bàn" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding MaLoaiBan, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Tên loại bàn" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding TenLoaiBan, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Mức phụ thu" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding PhuThu, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Thao tác" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource ButtonSecondary}" Padding="5" Margin="0,0,5,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                                            Command="{Binding DataContext.QuyDinhBanAn.EditLoaiBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <fa:IconBlock FontSize="14">
                                                            <fa:IconBlock.Style>
                                                                <Style TargetType="fa:IconBlock">
                                                                    <Setter Property="Icon" Value="Edit"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                                                            <Setter Property="Icon" Value="Check"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </fa:IconBlock.Style>
                                                        </fa:IconBlock>
                                                    </Button>
                                                    <Button Style="{StaticResource ButtonDanger}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                                            Command="{Binding DataContext.QuyDinhBanAn.DeleteLoaiBanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <fa:IconBlock Icon="Trash" FontSize="14"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </controls:EditablePaginatedView>

                        <Button Content="Lưu thay đổi" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinhBanAn.SaveChangesCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Quy định loại món ăn &amp; đơn vị tính -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Quy định loại món ăn và đơn vị tính" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Loại món ăn -->
                            <StackPanel Grid.Column="0">
                                <controls:EditablePaginatedView HorizontalAlignment="Stretch"
                                    AddRowButtonText="Thêm loại món ăn"
                                    AddRowCommand="{Binding QuyDinhLoaiMonAn.AddLoaiMonAnCommand}"
                                    PageSize="{Binding QuyDinhLoaiMonAn.PageSize, Mode=TwoWay}"
                                    PageNumber="{Binding QuyDinhLoaiMonAn.PageNumber, Mode=TwoWay}"
                                    TotalInfoText="{Binding QuyDinhLoaiMonAn.TotalInfoText}"
                                    PrevPageCommand="{Binding QuyDinhLoaiMonAn.PrevPageCommand}"
                                    NextPageCommand="{Binding QuyDinhLoaiMonAn.NextPageCommand}"
                                    PageSizes="{Binding QuyDinhLoaiMonAn.PageSizes}"
                                    PageNumbers="{Binding QuyDinhLoaiMonAn.PageNumbers}">
                                    <DataGrid ItemsSource="{Binding QuyDinhLoaiMonAn.PagedItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Style="{StaticResource GeneralDataGrid}" Height="180" Margin="0,0,0,5" SelectionMode="Single">
                                        <DataGrid.Resources>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsReadOnly" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Mã loại món" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding MaLoaiMonAn, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Tên loại món ăn" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding TenLoaiMonAn, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Thao tác" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Style="{StaticResource ButtonSecondary}" Padding="5" Margin="0,0,5,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    Command="{Binding DataContext.QuyDinhLoaiMonAn.EditLoaiMonAnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <fa:IconBlock FontSize="14">
                                                                    <fa:IconBlock.Style>
                                                                        <Style TargetType="fa:IconBlock">
                                                                            <Setter Property="Icon" Value="Edit"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                                                                    <Setter Property="Icon" Value="Check"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </fa:IconBlock.Style>
                                                                </fa:IconBlock>
                                                            </Button>
                                                            <Button Style="{StaticResource ButtonDanger}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                                                    Command="{Binding DataContext.QuyDinhLoaiMonAn.DeleteLoaiMonAnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <fa:IconBlock Icon="Trash" FontSize="14"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </controls:EditablePaginatedView>
                                <Button Content="Lưu thay đổi" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinhLoaiMonAn.SaveChangesCommand}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            </StackPanel>

                            <!-- Đơn vị tính -->
                            <StackPanel Grid.Column="2">
                                <controls:EditablePaginatedView HorizontalAlignment="Stretch"
                                    AddRowButtonText="Thêm đơn vị tính"
                                    AddRowCommand="{Binding QuyDinhDonViTinh.AddDonViTinhCommand}"
                                    PageSize="{Binding QuyDinhDonViTinh.PageSize, Mode=TwoWay}"
                                    PageNumber="{Binding QuyDinhDonViTinh.PageNumber, Mode=TwoWay}"
                                    TotalInfoText="{Binding QuyDinhDonViTinh.TotalInfoText}"
                                    PrevPageCommand="{Binding QuyDinhDonViTinh.PrevPageCommand}"
                                    NextPageCommand="{Binding QuyDinhDonViTinh.NextPageCommand}"
                                    PageSizes="{Binding QuyDinhDonViTinh.PageSizes}"
                                    PageNumbers="{Binding QuyDinhDonViTinh.PageNumbers}">
                                    <DataGrid ItemsSource="{Binding QuyDinhDonViTinh.PagedItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" Style="{StaticResource GeneralDataGrid}" Height="180" Margin="0,0,0,5" SelectionMode="Single">
                                        <DataGrid.Resources>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                                                <Style.Triggers>
                                                    <Trigger Property="IsReadOnly" Value="True">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Mã đơn vị tính" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding MaDonViTinh, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Tên đơn vị tính" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding TenDonViTinh, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Thao tác" Width="130">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Style="{StaticResource ButtonSecondary}" Padding="5" Margin="0,0,5,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}"
                                                                    Command="{Binding DataContext.QuyDinhDonViTinh.EditDonViTinhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <fa:IconBlock FontSize="14">
                                                                    <fa:IconBlock.Style>
                                                                        <Style TargetType="fa:IconBlock">
                                                                            <Setter Property="Icon" Value="Edit"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsReadOnly}" Value="False">
                                                                                    <Setter Property="Icon" Value="Check"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </fa:IconBlock.Style>
                                                                </fa:IconBlock>
                                                            </Button>
                                                            <Button Style="{StaticResource ButtonDanger}" Padding="5" Background="Transparent" BorderThickness="0" Foreground="{StaticResource DangerBrush}"
                                                                    Command="{Binding DataContext.QuyDinhDonViTinh.DeleteDonViTinhCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                                <fa:IconBlock Icon="Trash" FontSize="14"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </controls:EditablePaginatedView>
                                <Button Content="Lưu thay đổi" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinhDonViTinh.SaveChangesCommand}" HorizontalAlignment="Right" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,15,0,10"/>

                        <TextBlock Text="Liên kết loại món ăn — đơn vị tính" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Background="#FAFAFA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding QuyDinhLoaiMonAnDvt.ColumnHeaders}" Margin="0,0,0,5">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="13" TextAlignment="Center" Margin="5,0" MinWidth="90" Padding="10,5"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl ItemsSource="{Binding QuyDinhLoaiMonAnDvt.Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="0,3">
                                                    <ItemsControl ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <VirtualizingStackPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding TenDonViTinh}" Margin="5,0" MinWidth="90" VerticalAlignment="Center" FontSize="13"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Button Content="Lưu thay đổi" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinhLoaiMonAnDvt.SaveChangesCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Quy định thanh toán -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="Quy định thanh toán" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="Chỉ được thanh toán đối với bàn khi có ít nhất 1 phiếu gọi món có trạng thái:" FontSize="13" Margin="0,0,0,15"/>

                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15" Background="#FAFAFA" HorizontalAlignment="Left" Width="300">
                            <ItemsControl ItemsSource="{Binding QuyDinhTrangThaiThanhToan.Statuses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding TenTrangThai}" IsChecked="{Binding DuocThanhToan}" Margin="0,5,0,5" FontSize="13"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Content="Lưu thay đổi" Style="{StaticResource ButtonPrimary}" Command="{Binding QuyDinhTrangThaiThanhToan.SaveChangesCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
