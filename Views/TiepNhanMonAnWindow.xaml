<Window x:Class="QuanLyNhaHang.Views.TiepNhanMonAnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuanLyNhaHang.Views"
        xmlns:controls="clr-namespace:QuanLyNhaHang.Controls"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        mc:Ignorable="d"
        Title="" Height="650" Width="850"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Ticket Info Header Form -->
            <RowDefinition Height="Auto"/>
            <!-- Detail Grid Table (ControlTable) -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Tiếp nhận món ăn" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
        </Grid>

        <!-- Ticket Info Header Form -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Loại món ăn" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CbLoaiMonAn" Style="{StaticResource InputComboBox}" ItemsSource="{Binding LoaiMonAns}" SelectedValue="{Binding SelectedMaLoaiMonAn}" DisplayMemberPath="TenLoaiMonAn" SelectedValuePath="MaLoaiMonAn"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Detail Grid Table (ControlTable) -->
        <controls:ControlTable Grid.Row="2" Margin="0,0,0,15"
                               VerticalAlignment="Stretch"
                               ItemsSource="{Binding PagedItems}"
                               SelectedItem="{Binding SelectedMonAn}"
                               AddRowCommand="{Binding AddRowCommand}"
                               PageSize="{Binding PageSize, Mode=TwoWay}"
                               PageNumber="{Binding PageNumber, Mode=TwoWay}"
                               TotalInfoText="{Binding TotalInfoText}"
                               PrevPageCommand="{Binding PrevPageCommand}"
                               NextPageCommand="{Binding NextPageCommand}"
                               PageSizes="{Binding PageSizes}"
                               PageNumbers="{Binding PageNumbers}">
            <DataGrid ItemsSource="{Binding PagedItems}" SelectedItem="{Binding SelectedMonAn}"
                      Style="{StaticResource GeneralDataGrid}"
                      VerticalScrollBarVisibility="Visible"
                      Validation.ErrorTemplate="{x:Null}"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="STT" Width="60" Binding="{Binding STT}" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="TÊN MÓN ĂN" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         VerticalAlignment="Center" Margin="2"
                                         Text="{Binding TenMonAn, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ĐƠN VỊ TÍNH" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          VerticalAlignment="Center" Margin="2"
                                          ItemsSource="{Binding DataContext.AllowedDonViTinhs, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedValue="{Binding SelectedMaDonViTinh, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="TenDonViTinh"
                                          SelectedValuePath="MaDonViTinh"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TÌNH TRẠNG" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          VerticalAlignment="Center" Margin="2"
                                          ItemsSource="{Binding DataContext.TinhTrangs, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedValue="{Binding SelectedMaTinhTrang, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="TenTinhTrang"
                                          SelectedValuePath="MaTinhTrang"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="ĐƠN GIÁ" Width="1.5*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         VerticalAlignment="Center" Margin="2"
                                         Text="{Binding DonGia, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="THAO TÁC" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ButtonDanger}" Padding="6,4" 
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                        CommandParameter="{Binding}">
                                    <fa:IconBlock Icon="Trash" FontSize="12"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </controls:ControlTable>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3">
            <Button x:Name="BtnAccept" Style="{StaticResource ButtonPrimary}" HorizontalAlignment="Left" Command="{Binding AcceptCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Plus" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Thêm món ăn" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnReset" Style="{StaticResource ButtonSecondary}" Command="{Binding ResetCommand}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Undo" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đặt lại" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCancel" Style="{StaticResource ButtonDanger}" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconBlock Icon="Times" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Thoát" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
